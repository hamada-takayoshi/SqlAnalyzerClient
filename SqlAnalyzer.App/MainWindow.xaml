<Window x:Class="SqlAnalyzer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SQL解析クライアント"
        Width="1400"
        Height="860"
        MinWidth="1100"
        MinHeight="700">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#C8CCD4"
                BorderThickness="0,0,0,1"
                Background="#F7F8FA"
                Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Text="SQL方言" />
                <ComboBox Grid.Column="1"
                          Width="160"
                          Margin="0,0,12,0"
                          ItemsSource="{Binding Dialects}"
                          SelectedItem="{Binding SelectedDialect}" />

                <Button Grid.Column="2"
                        Width="90"
                        Margin="0,0,8,0"
                        Content="整形"
                        Command="{Binding FormatCommand}" />
                <Button Grid.Column="3"
                        Width="90"
                        Margin="0,0,8,0"
                        Content="解析"
                        Command="{Binding AnalyzeCommand}" />
                <Button Grid.Column="4"
                        Width="90"
                        Margin="0,0,8,0"
                        Content="キャンセル"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="5"
                        Width="90"
                        Margin="0,0,8,0"
                        Content="設定"
                        Command="{Binding SettingsCommand}" />

                <StackPanel Grid.Column="7"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Margin="0,0,16,0"
                               Text="{Binding StatusText}" />
                    <TextBlock Margin="0,0,16,0"
                               Text="{Binding ExecutionTimeText}" />
                    <TextBlock Text="{Binding BoundaryInfoText}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0"
                  Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Margin="0,0,0,8"
                           FontWeight="SemiBold"
                           Text="SQLエディター" />

                <TextBox Grid.Row="1"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="14"
                         Text="{Binding SqlText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="2"
                           Margin="0,8,0,0"
                           Foreground="#4A5568"
                           Text="最初のSQLステートメント（';' または GO で終端）のみ解析されます。" />
            </Grid>

            <TabControl Grid.Column="1"
                        Margin="8,0,0,0">
                <TabItem Header="概要">
                    <StackPanel Margin="12">
                        <TextBlock Text="{Binding StatementTypeText, StringFormat=ステートメント種別: {0}}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding TableCount, StringFormat=テーブル数: {0}}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding RelationCount, StringFormat=リレーション数: {0}}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding SelectItemCount, StringFormat=SELECT項目数: {0}}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding DiagnosticCount, StringFormat=診断数: {0}}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding BoundaryKindText, StringFormat=境界種別: {0}}" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="テーブル">
                    <DataGrid AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              ItemsSource="{Binding Tables}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="表示名" Binding="{Binding DisplayName}" />
                            <DataGridTextColumn Header="スキーマ" Binding="{Binding Schema}" />
                            <DataGridTextColumn Header="オブジェクト" Binding="{Binding Object}" />
                            <DataGridTextColumn Header="別名" Binding="{Binding Alias}" />
                            <DataGridTextColumn Header="論理名" Binding="{Binding LogicalName}" />
                            <DataGridTextColumn Header="役割" Binding="{Binding Role}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="リレーション">
                    <DataGrid AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              ItemsSource="{Binding Relations}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="元テーブル" Binding="{Binding FromTable}" />
                            <DataGridTextColumn Header="結合種別" Binding="{Binding JoinType}" />
                            <DataGridTextColumn Header="先テーブル" Binding="{Binding ToTable}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="SELECT項目">
                    <Grid>
                        <TextBlock Margin="12"
                                   VerticalAlignment="Top"
                                   Foreground="#4A5568"
                                   Text="このSQLステートメントはSELECTではありません。"
                                   Visibility="{Binding IsNotSelectStatement, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <Grid Visibility="{Binding IsSelectStatement, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DataGrid Grid.Row="0"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      ItemsSource="{Binding SelectItems}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="出力名" Binding="{Binding OutputName}" />
                                    <DataGridTextColumn Header="式" Binding="{Binding Expression}" />
                                    <DataGridTextColumn Header="テーブル" Binding="{Binding Table}" />
                                    <DataGridTextColumn Header="列名" Binding="{Binding ColumnName}" />
                                    <DataGridTextColumn Header="論理名" Binding="{Binding LogicalName}" />
                                    <DataGridTextColumn Header="解決状態" Binding="{Binding ResolutionStatus}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Row="1"
                                        Margin="8"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Width="130"
                                        Margin="0,0,8,0"
                                        Content="CSVとして出力"
                                        IsEnabled="False" />
                                <Button Width="150"
                                        Content="Markdownとして出力"
                                        IsEnabled="False" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="図">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center"
                                       Text="表示モード"
                                       Margin="0,0,8,0" />
                            <ComboBox Width="190"
                                      ItemsSource="{Binding DiagramModes}"
                                      SelectedItem="{Binding SelectedDiagramMode}" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Margin="0,10,0,10"
                                Padding="12"
                                BorderBrush="#D3D7DE"
                                BorderThickness="1"
                                Visibility="{Binding IsDiagramImageMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ScrollViewer Grid.Row="0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto">
                                    <Image Stretch="None"
                                           Source="{Binding DiagramImageSource}" />
                                </ScrollViewer>
                                <TextBlock Grid.Row="1"
                                           Margin="0,10,0,0"
                                           Foreground="#B00020"
                                           Text="{Binding DiagramErrorMessage}" />
                            </Grid>
                        </Border>

                        <TextBox Grid.Row="1"
                                 Margin="0,10,0,10"
                                 FontFamily="Consolas"
                                 IsReadOnly="True"
                                 Text="{Binding MermaidText}"
                                 Visibility="{Binding IsMermaidMode, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Width="110"
                                    Margin="0,0,8,0"
                                    Content="PNG保存"
                                    Command="{Binding SavePngCommand}" />
                            <Button Width="130"
                                    Margin="0,0,8,0"
                                    Content="Markdown保存"
                                    Command="{Binding SaveMermaidCommand}" />
                            <Button Width="150"
                                    Content="クリップボードにコピー"
                                    Command="{Binding CopyMermaidCommand}" />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="診断">
                    <DataGrid AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              ItemsSource="{Binding Diagnostics}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="重要度" Binding="{Binding Severity}" />
                            <DataGridTextColumn Header="コード" Binding="{Binding Code}" />
                            <DataGridTextColumn Header="メッセージ" Binding="{Binding Message}" />
                            <DataGridTextColumn Header="位置" Binding="{Binding Location}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
